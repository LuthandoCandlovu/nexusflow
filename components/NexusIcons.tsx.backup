// ============================================
// NEXUSFLOW - CUSTOM ICON COMPONENT
// ============================================
export const NexusIcon = ({ name, focused, color, size = 24, ...props }) => {
  // Get icon config from NexusIcons
  const iconConfig = typeof NexusIcons[name] === 'function' 
    ? NexusIcons[name]({ focused, color, size })
    : { name, color, size };
  
  return (
    <Ionicons 
      name={iconConfig.name} 
      size={iconConfig.size || size} 
      color={iconConfig.color || color || BRAND.colors.primary} 
      {...props} 
    />
  );
};

// ============================================
// NEXUSFLOW - PREMIUM FEATURE BADGES
// ============================================
export const NexusBadge = ({ type, size = 16 }) => {
  const badges = {
    enterprise: { icon: 'business', color: BRAND.colors.primary },
    security: { icon: 'shield', color: BRAND.colors.success },
    ai: { icon: 'flash', color: BRAND.colors.secondary },
    beta: { icon: 'flask', color: BRAND.colors.accent },
    pro: { icon: 'star', color: BRAND.colors.warning },
    new: { icon: 'sparkles', color: BRAND.colors.secondary },
  };

  const badge = badges[type] || badges.enterprise;

  return (
    <View style={{ flexDirection: 'row', alignItems: 'center' }}>
      <Ionicons name={badge.icon} size={size} color={badge.color} />
    </View>
  );
};

export default NexusIcon;
